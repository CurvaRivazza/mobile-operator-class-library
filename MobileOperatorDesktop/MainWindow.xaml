<Window x:Class="MobileOperatorDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MobileOperatorDesktop"
        xmlns:views="clr-namespace:MobileOperatorDesktop.Views"
        mc:Ignorable="d"
        Title="Личный кабинет оператора мобильной связи" Height="720" Width="1200"
        WindowStartupLocation="CenterScreen">
    <TabControl>
        <TabItem Header="Клиенты">
            <views:ClientsPage/>
        </TabItem>
        <TabItem Header="Детализация">
            <views:DetailsPage/>
        </TabItem>
    </TabControl>
</Window>
