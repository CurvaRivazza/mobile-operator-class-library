<UserControl x:Class="MobileOperatorDesktop.Views.ClientsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MobileOperatorDesktop.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Loaded="UserControl_Loaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Обновить" Padding="10,5" Margin="0,0,8,0" Click="Refresh_Click"/>
            <Button Content="Пополнить" Padding="10,5" Margin="0,0,8,0" Click="TopUp_Click"/>
            <Button Content="Списать" Padding="10,5" Margin="0,0,8,0" Click="Debit_Click"/>
            <Button Content="Прогноз обнуления" Padding="10,5" Margin="0,0,8,0" Click="Predict_Click"/>
            <Button Content="Предложения клиента" Padding="10,5" Margin="0,0,8,0" Click="ShowOffersByClient_Click"/>
            <Button Content="Все предложения" Padding="10,5" Click="ShowOffers_Click"/>
        </StackPanel>
        <DataGrid x:Name="ClientsGrid" Grid.Row="1"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="*"/>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                <DataGridTextColumn Header="Номер" Binding="{Binding PhoneNumber}" Width="*"/>
                <DataGridTextColumn Header="Баланс" Binding="{Binding Balance, StringFormat={}{0:C}}" Width="*"/>
                <DataGridTextColumn Header="Тариф" Binding="{Binding CurrentTariff.Name}" Width="*"/>
                <DataGridTextColumn Header="Тип тарифа" Binding="{Binding CurrentTariff}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <GroupBox Grid.Row="2" Header="События баланса">
            <ListBox x:Name="EventsLog"/>
        </GroupBox>
    </Grid>
</UserControl>
